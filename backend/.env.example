# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set your MongoDB Atlas URI or Local MongoDB URI
MONGODB_URI=mongodb://localhost:27017/goalflow

# JWT Secrets
JWT_SECRET=super_secret_jwt_sign_key_for_goalflow_production_ready_saas_app
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_sign_key_for_goalflow_refresh_tokens_123
JWT_REFRESH_EXPIRE=7d

# Cookie Configuration
# Express cookie expiry in milliseconds (e.g. 7 days = 604800000 ms)
COOKIE_EXPIRE=604800000

# Nodemailer / SMTP Email Configurations (for reminders & auth)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
FROM_EMAIL=noreply@goalflow.com
FROM_NAME="GoalFlow Support"

# Cloudinary Credentials (Optional - for avatar uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate Limiter
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
